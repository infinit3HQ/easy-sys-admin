---
import { plans } from '@esa/plans'
import type { Plan } from '@esa/plans'

function href(plan: Plan): string | undefined {
  if (plan.cta.kind === 'docs') return plan.cta.path
  if (plan.cta.kind === 'mail') return plan.cta.href
  return undefined
}
---

<div class="plans">
  {
    plans.map((plan) => {
      const link = href(plan)
      return (
        <article class:list={['plan', { current: plan.state === 'current' }]}>
          <p class="state">{plan.stateLabel}</p>
          <h2>{plan.name}</h2>
          <p class="price">
            {plan.price} <span>{plan.priceDetail}</span>
          </p>
          <p>{plan.summary}</p>
          <ul>
            {plan.features.map((feature) => (
              <li>{feature}</li>
            ))}
          </ul>
          {link ? (
            <a href={link}>{plan.cta.label}</a>
          ) : (
            <p class="current-label">{plan.cta.label}</p>
          )}
        </article>
      )
    })
  }
</div>

<style>
  .plans {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 50rem) {
    .plans {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .plan {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin: 0;
    padding: 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
  }
  .plan.current {
    border-color: var(--sl-color-accent);
  }
  .state {
    margin: 0;
    font-size: var(--sl-text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .plan h2 {
    margin: 0;
    font-size: var(--sl-text-h4);
    border: 0;
  }
  .price {
    margin: 0;
    font-size: var(--sl-text-h3);
  }
  .price span {
    display: block;
    margin-top: 0.25rem;
    font-size: var(--sl-text-sm);
  }
  .plan ul {
    flex: 1;
    margin: 0;
    padding-left: 1.1rem;
  }
  .current-label {
    margin: 0;
    font-weight: 600;
  }
</style>
