# Production settings for deploy/compose.yaml. Keep this file on the server
# only, readable by the deploy user (chmod 600). Never commit it.

# Public hostname and origin.
ESA_HOST=esa.example.com
ESA_PUBLIC_URL=https://esa.example.com

# openssl rand -base64 32   (losing it makes stored secrets unreadable; back it up)
ESA_MASTER_KEY=
# openssl rand -hex 24
POSTGRES_PASSWORD=

# Sign-in.
ESA_AUTH_PASSWORD=true
ESA_SIGNUP=true
# ESA_ALLOWED_EMAILS=you@example.com

# Authentik or another OIDC provider. Redirect URI: https://<ESA_HOST>/auth/callback/oidc
# ESA_OIDC_ISSUER=https://auth.example.com/application/o/esa/
# ESA_OIDC_CLIENT_ID=
# ESA_OIDC_CLIENT_SECRET=
# ESA_OIDC_PROVIDER_NAME=Authentik

# Google. Redirect URI: https://<ESA_HOST>/auth/callback/google
# ESA_GOOGLE_CLIENT_ID=
# ESA_GOOGLE_CLIENT_SECRET=

# Stack and Traefik. Change ESA_ROUTER if another router on this Traefik is named esa.
ESA_STACK_NAME=esa
ESA_ROUTER=esa
TRAEFIK_NETWORK=proxy
TRAEFIK_CERT_RESOLVER=cloudflare
TRAEFIK_ENTRYPOINT=websecure
