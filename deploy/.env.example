# Production settings for deploy/compose.yaml. Keep this file on the server
# only, readable by the deploy user (chmod 600). Never commit it.

# Public hostname and origin.
ESA_HOST=esa.example.com
ESA_PUBLIC_URL=https://esa.example.com
# Index the landing page, pricing, privacy policy, and terms. Leave unset to ask crawlers to stay away.
# ESA_SEO=false

# Source offer in the web footer. Unset links to the upstream GitHub repository.
# Set your own URL when you publish a modified build. The footer also shows
# ESA_VERSION and ESA_COMMIT, which the deploy workflow writes.
# ESA_SOURCE_URL=https://github.com/infinit3HQ/easy-sys-admin

# openssl rand -base64 32   (losing it makes stored secrets unreadable; back it up)
ESA_MASTER_KEY=
# openssl rand -hex 24
POSTGRES_PASSWORD=

# Sign-in. ESA_SIGNUP=true lets anyone who reaches the site create an account
# and their own fleet (default false; ignored when ESA_ALLOWED_EMAILS is set).
# The first account can always be created while no user exists.
ESA_AUTH_PASSWORD=true
ESA_SIGNUP=false
# ESA_ALLOWED_EMAILS=you@example.com

# Whether servers, certificate checks, and channels may use private or loopback
# addresses. Link-local and cloud metadata addresses are always refused.
# Unset uses the default: allowed only when no stranger can sign in (sign-up off, and any
# Google or OIDC provider limited by ESA_ALLOWED_EMAILS). Refused otherwise.
# ESA_ALLOW_PRIVATE_NETWORKS=true

# Authentik or another OIDC provider. Redirect URI: https://<ESA_HOST>/auth/callback/oidc
# ESA_OIDC_ISSUER=https://auth.example.com/application/o/esa/
# ESA_OIDC_CLIENT_ID=
# ESA_OIDC_CLIENT_SECRET=
# ESA_OIDC_PROVIDER_NAME=Authentik

# Google. Redirect URI: https://<ESA_HOST>/auth/callback/google
# ESA_GOOGLE_CLIENT_ID=
# ESA_GOOGLE_CLIENT_SECRET=
# Resend. The from address must be on a domain verified in Resend.
# ESA_SMTP_PASSWORD is a production secret, not a repository variable.
# ESA_SMTP_HOST=smtp.resend.com
# ESA_SMTP_PORT=587
# ESA_SMTP_USERNAME=resend
# ESA_SMTP_PASSWORD=YOUR_API_KEY
# ESA_SMTP_FROM=Easy Sys Admin <mail@example.com>

# Polling and limits. Unset keeps the defaults: 64 servers polled at once,
# 500 servers per account, samples kept 48h, hourly averages 2160h (90 days).
# ESA_POLL_CONCURRENCY=64
# ESA_MAX_SERVERS_PER_ACCOUNT=500
# ESA_BETA_LIMITS=false
# ESA_METRICS_RAW_RETENTION=48h
# ESA_METRICS_HOURLY_RETENTION=2160h

# Stack and Traefik. Change ESA_ROUTER if another router on this Traefik is named esa.
ESA_STACK_NAME=esa
ESA_ROUTER=esa
TRAEFIK_NETWORK=proxy
TRAEFIK_CERT_RESOLVER=cloudflare
TRAEFIK_ENTRYPOINT=websecure

# Published images. With compose.images.yaml, both are required. Choose a
# matching stable/nightly tag, commit tag, or preferably exact image digests.
# Leave unset for local source builds with compose.yaml alone.
# ESA_CONTROL_PLANE_IMAGE=ghcr.io/infinit3hq/easy-sys-admin-control-plane:stable
# ESA_WEB_IMAGE=ghcr.io/infinit3hq/easy-sys-admin-web:stable

# Memory and process ceilings for the control plane and the web container.
# ESA_MEM_LIMIT=2g
# ESA_WEB_MEM_LIMIT=1g
# ESA_PIDS_LIMIT=1024

# Optional host-local directory for pre-deployment production database dumps.
# Defaults to the runner user's ~/.local/state/easy-sys-admin/production/backups.
# ESA_DEPLOY_BACKUP_DIR=
# How many dumps to keep. Older ones are deleted after each new backup. Default 14.
# ESA_BACKUP_KEEP=14
# An age public key (age1...). When set, dumps are encrypted to it and end in
# .dump.age, and the backup stops if age is not installed. Keep the private key
# off this host, and the master key somewhere else again.
# ESA_BACKUP_AGE_RECIPIENT=
