# Copy to .env for local development. `pnpm dev` reads it.
# Never commit .env.

# --- Control plane (apps/esa) ---------------------------------------------

# PostgreSQL connection string.
ESA_DATABASE_URL=postgres://localhost:5432/esa_dev?sslmode=disable

# Bind address of the Go API. The web app proxies /api and /auth to it.
ESA_LISTEN=127.0.0.1:8080

# Origin you open in the browser (the web app).
ESA_PUBLIC_URL=http://localhost:3000

# "dev" signs you in as a local user without an identity provider.
# Only allowed when ESA_LISTEN and ESA_PUBLIC_URL are loopback addresses.
ESA_AUTH_MODE=dev

# OIDC settings for ESA_AUTH_MODE=oidc (Authentik: Applications > Providers > OAuth2/OpenID).
# Redirect URI to register at the provider: <ESA_PUBLIC_URL>/auth/callback
# ESA_OIDC_ISSUER=https://auth.example.com/application/o/esa/
# ESA_OIDC_CLIENT_ID=
# ESA_OIDC_CLIENT_SECRET=
# ESA_OIDC_PROVIDER_NAME=Authentik

# Comma-separated emails allowed to sign in. Empty allows anyone the provider lets through.
# ESA_ALLOWED_EMAILS=


# --- Web app (apps/web) ------------------------------------------------------

# Where the web server reaches the Go API (server side only).
ESA_API_URL=http://127.0.0.1:8080

# --- Secrets and helpers -----------------------------------------------------

# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Comma-separate several keys to rotate: the first seals new secrets.
ESA_MASTER_KEY=

# Directory with esa-helper-linux-amd64 and esa-helper-linux-arm64
# (built by `pnpm --filter @esa/esa build:helpers`).
ESA_HELPER_DIR=./apps/esa/bin

# --- Tests --------------------------------------------------------------------

# Disposable PostgreSQL database for Go integration tests. It is wiped on every run.
# ESA_TEST_DATABASE_URL=postgres://localhost:5432/esa_test?sslmode=disable
