# Copy to .env for local development. `pnpm dev` reads it.
# Never commit .env.

# --- Control plane (apps/esa) ---------------------------------------------

# PostgreSQL connection string.
ESA_DATABASE_URL=postgres://localhost:5432/esa_dev?sslmode=disable

# Bind address of the Go API. The web app proxies /api and /auth to it.
ESA_LISTEN=127.0.0.1:8080

# Origin you open in the browser (the web app).
ESA_PUBLIC_URL=http://localhost:3000

# Sign-in methods. Any combination can be on.
#   ESA_AUTH_MODE=dev       adds a one-click local dev login (loopback only)
#   ESA_AUTH_PASSWORD=true  email and password sign-in (default true)
#   ESA_SIGNUP=true         anyone can create an email and password account (default false;
#                           the first account can always be created while no user exists;
#                           ignored when ESA_ALLOWED_EMAILS is set)
ESA_AUTH_MODE=dev
# ESA_AUTH_PASSWORD=true
# ESA_SIGNUP=true

# Whether servers, certificate checks, and channels may use private or loopback
# addresses. Link-local and cloud metadata addresses are always refused.
# Unset uses the default: allowed while sign-up is off, refused while it is on.
# ESA_ALLOW_PRIVATE_NETWORKS=true

# Generic OpenID Connect, for example Authentik (Applications > Providers > OAuth2/OpenID).
# Redirect URI to register: <ESA_PUBLIC_URL>/auth/callback/oidc
# ESA_OIDC_ISSUER=https://auth.example.com/application/o/esa/
# ESA_OIDC_CLIENT_ID=
# ESA_OIDC_CLIENT_SECRET=
# ESA_OIDC_PROVIDER_NAME=Authentik

# Google sign-in (Google Cloud console > APIs & Services > Credentials > OAuth client, type Web).
# Redirect URI to register: <ESA_PUBLIC_URL>/auth/callback/google
# ESA_GOOGLE_CLIENT_ID=
# ESA_GOOGLE_CLIENT_SECRET=

# Comma-separated emails allowed to sign in with any method. Empty allows anyone.
# ESA_ALLOWED_EMAILS=

# --- Secrets and helpers -----------------------------------------------------

# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Comma-separate several keys to rotate: the first seals new secrets.
ESA_MASTER_KEY=

# Directory with esa-helper-linux-amd64 and esa-helper-linux-arm64, built by
# `pnpm --filter @esa/esa build:helpers`. A relative path resolves against the
# directory the control plane starts in; `pnpm --filter @esa/esa dev` starts in
# apps/esa, where the default ./bin is right.
# ESA_HELPER_DIR=./bin

# --- Polling, limits, and metrics -------------------------------------------

# Servers polled at once (1 to 512). One status call takes about 1.25 s, so 64
# covers roughly 2,800 servers per minute.
# ESA_POLL_CONCURRENCY=64
# Time allowed for the TCP connect to a server. The SSH handshake gets 15s more.
# ESA_SSH_CONNECT_TIMEOUT=5s
# Most servers one account can add (1 to 100000).
# ESA_MAX_SERVERS_PER_ACCOUNT=500
# How long per-poll samples (at least 2h) and hourly averages (at least the
# raw retention) are kept. 2160h is 90 days.
# ESA_METRICS_RAW_RETENTION=48h
# ESA_METRICS_HOURLY_RETENTION=2160h
# GET /metrics (Prometheus format, no login) on ESA_LISTEN. Not proxied by the web app.
# ESA_METRICS=true

# --- Tests --------------------------------------------------------------------

# Disposable PostgreSQL database for Go integration tests. It is wiped on every run.
# ESA_TEST_DATABASE_URL=postgres://localhost:5432/esa_test?sslmode=disable
